fn main() {
    var counter = 0
    let id = 42
    
    // ERROR: capturing mutable state without explicit capability grant
    // spawn task {
    //     counter = counter + 1
    //     print_int(id)
    // }
    
    // OK: explicit capability grant
    spawn task [write counter] {
        counter = counter + 1
        print_int(id)
    }
}
